rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // A conta é sempre do adulto responsável. Cada criança é um perfil com um
    // avatar de uma lista fechada, sem nenhum texto livre, e nada de nome ou idade.
    // Qualquer outro caminho é negado por padrão.
    match /usuarios/{uid}/perfis/{perfilId} {
      function dono() {
        return request.auth != null && request.auth.uid == uid;
      }

      function perfilValido() {
        let dados = request.resource.data;
        return dados.keys().hasOnly(['avatar', 'criadoEm'])
          && dados.keys().hasAll(['avatar', 'criadoEm'])
          && dados.avatar in ['raposa', 'panda', 'sapo', 'polvo', 'leao', 'coala', 'pinguim', 'tigre']
          && dados.criadoEm == request.time;
      }

      allow read, delete: if dono();
      allow create: if dono() && perfilValido();

      // Recorde e fase só sobem.
      match /progresso/{jogoId} {
        function progressoValido() {
          let dados = request.resource.data;
          return dados.keys().hasOnly(['recorde', 'fase', 'atualizadoEm'])
            && dados.keys().hasAll(['recorde', 'fase', 'atualizadoEm'])
            && dados.recorde is int && dados.recorde >= 0
            && dados.fase is int && dados.fase >= 1
            && dados.atualizadoEm == request.time;
        }

        allow read, delete: if dono();
        allow create: if dono() && progressoValido();
        allow update: if dono() && progressoValido()
          && request.resource.data.recorde >= resource.data.recorde
          && request.resource.data.fase >= resource.data.fase;
      }
    }
  }
}
