---
import Jogo from "../../layouts/Jogo.astro";
import { ALTURA, LARGURA, MEIA_PISTA } from "../../jogos/corrida/pistas";
import "../../jogos/corrida/jogo.css";

const largura = 2 * MEIA_PISTA;
// O pedal do freio: mais largo em cima, com os cantos arredondados.
const FREIO = "M14 4H52Q62 4 61 14L56.5 50Q55.5 59 46 59H20Q10.5 59 9.5 50L5 14Q4 4 14 4Z";
---

<Jogo id="corrida">
  <div
    id="cena"
    class="cena"
    tabindex="0"
    role="application"
    aria-label="Pista de corrida. Seta para cima acelera, para baixo dá ré, e as dos lados viram. Espaço liga o turbo."
  >
    <svg id="mundo" class="mundo" viewBox={`0 0 ${LARGURA} ${ALTURA}`} aria-hidden="true">
      <g id="cenario"></g>
      <g class="estrada">
        <path class="estrada-muro-borda" data-alem-do-muro="5"></path>
        <path class="estrada-muro" data-alem-do-muro="3.5"></path>
        <path class="estrada-grama" data-alem-do-muro="0"></path>
        <path class="estrada-borda" stroke-width={largura + 8}></path>
        <path class="estrada-zebra" stroke-width={largura + 4}></path>
        <path class="estrada-zebra-listra" stroke-width={largura + 4}></path>
        <path class="estrada-chao" stroke-width={largura - 4}></path>
        <path class="estrada-faixa"></path>
      </g>
      <g id="largada"></g>
      <g id="montes"></g>
      <g id="obstaculos"></g>
      <g id="rivais"></g>
      <g id="jogador"></g>
    </svg>
    <div class="hud">
      <span id="carteira" class="selo carteira">R$ 0,00</span>
      <span id="volta" class="selo"></span>
      <span id="posicao" class="selo posicao" hidden></span>
    </div>
    <p id="semaforo" class="semaforo" hidden></p>
    <p id="fala" class="fala" aria-live="polite"></p>
  </div>

  <!-- Um par de botões para cada polegar: as setas viram, e os pedais freiam e aceleram. -->
  <div class="controles">
    <div id="volante" class="dupla volante" aria-hidden="true">
      {
        ["esquerda", "direita"].map((lado) => (
          <span class="seta" data-botao={lado}>
            <svg viewBox="0 0 48 44">
              <path d="M5 22 23 4v10h20v16H23v10z" />
            </svg>
          </span>
        ))
      }
    </div>
    <button id="turbo" class="turbo" type="button" hidden>
      <span class="turbo-carga"></span>
      <span class="turbo-texto"><span class="turbo-chama">🔥</span>Turbo</span>
    </button>
    <div id="pedais" class="dupla pedais" aria-hidden="true">
      <span class="pedal freio" data-botao="freio">
        <svg viewBox="0 0 66 67">
          <path class="pedal-sombra" d={FREIO} transform="translate(0 5)"></path>
          <g class="pedal-rosto">
            <path class="pedal-chapa" d={FREIO}></path>
            {
              [17, 31.5, 46].map((y, linha) =>
                [-1, 0, 1].map((lado) => <circle class="pedal-furo" cx={33 + lado * (14 - linha * 1.5)} cy={y} r="4" />),
              )
            }
          </g>
        </svg>
      </span>
      <span class="pedal acelerador" data-botao="acelerador">
        <svg viewBox="0 0 60 114">
          <rect class="pedal-sombra" x="3.5" y="8.5" width="53" height="103" rx="13"></rect>
          <g class="pedal-rosto">
            <rect class="pedal-chapa" x="3.5" y="3.5" width="53" height="103" rx="13"></rect>
            {
              [21, 38, 55, 72, 89].map((y) =>
                [21, 39].map((x) => <circle class="pedal-furo" cx={x} cy={y} r="4.5" />),
              )
            }
          </g>
        </svg>
      </span>
    </div>
  </div>
</Jogo>

<script>
  import "../../jogos/corrida/jogo";
</script>
