---
import Jogo from "../../layouts/Jogo.astro";
import "../../jogos/pantanal/jogo.css";
---

<Jogo id="pantanal">
  <!-- Os bichos são desenhados uma vez e usados com <use> na cena, nas cartas e no painel. -->
  <svg class="simbolos" aria-hidden="true">
    <defs>
      <symbol id="bicho-capim" viewBox="0 0 40 40">
        <path d="M20 36 C18 26 12 18 6 14 C14 16 18 22 20 28 C20 18 22 10 26 4 C25 14 24 24 22 36 Z M22 36 C24 28 28 22 35 18 C30 24 27 30 26 36 Z" fill="#62b84a" stroke="#2b2140" stroke-width="2.4" stroke-linejoin="round" />
      </symbol>
      <symbol id="bicho-peixe" viewBox="0 0 40 40">
        <path d="M6 20 C12 10 26 10 32 20 C26 30 12 30 6 20 Z" fill="#ff9f43" stroke="#2b2140" stroke-width="2.6" stroke-linejoin="round" />
        <path d="M31 20 L38 13 L38 27 Z" fill="#ff9f43" stroke="#2b2140" stroke-width="2.6" stroke-linejoin="round" />
        <circle cx="13" cy="18.5" r="2" fill="#2b2140" />
      </symbol>
      <symbol id="bicho-capivara" viewBox="0 0 40 40">
        <rect x="9" y="27" width="5" height="9" rx="2" fill="#8a5530" stroke="#2b2140" stroke-width="2.2" />
        <rect x="23" y="27" width="5" height="9" rx="2" fill="#8a5530" stroke="#2b2140" stroke-width="2.2" />
        <ellipse cx="18" cy="23" rx="15" ry="9" fill="#b0743f" stroke="#2b2140" stroke-width="2.6" />
        <path d="M26 13 Q38 12 38 21 Q38 27 30 27 Q24 27 24 20 Z" fill="#b0743f" stroke="#2b2140" stroke-width="2.6" stroke-linejoin="round" />
        <ellipse cx="28" cy="12.5" rx="2.4" ry="2" fill="#8a5530" stroke="#2b2140" stroke-width="2" />
        <circle cx="32" cy="17.5" r="1.8" fill="#2b2140" />
        <ellipse cx="37" cy="21" rx="1.4" ry="1" fill="#2b2140" />
      </symbol>
      <symbol id="bicho-onca" viewBox="0 0 40 40">
        <path d="M5 22 Q0 12 6 8" fill="none" stroke="#2b2140" stroke-width="5.5" stroke-linecap="round" />
        <path d="M5 22 Q0 12 6 8" fill="none" stroke="#f0b13c" stroke-width="2.6" stroke-linecap="round" />
        <rect x="9" y="27" width="5" height="9" rx="2" fill="#f0b13c" stroke="#2b2140" stroke-width="2.2" />
        <rect x="21" y="27" width="5" height="9" rx="2" fill="#f0b13c" stroke="#2b2140" stroke-width="2.2" />
        <ellipse cx="17" cy="23" rx="13" ry="8" fill="#f0b13c" stroke="#2b2140" stroke-width="2.6" />
        <circle cx="30" cy="15" r="8" fill="#f0b13c" stroke="#2b2140" stroke-width="2.6" />
        <path d="M24 9 L25 4 L29 7.5 Z M32 7.5 L36 4 L36.5 9.5 Z" fill="#f0b13c" stroke="#2b2140" stroke-width="2" stroke-linejoin="round" />
        <g fill="none" stroke="#2b2140" stroke-width="1.8">
          <circle cx="12" cy="20" r="2" /><circle cx="18" cy="24" r="2" /><circle cx="22" cy="19" r="1.8" /><circle cx="11" cy="26" r="1.6" />
        </g>
        <circle cx="28" cy="14" r="1.5" fill="#2b2140" /><circle cx="33" cy="14" r="1.5" fill="#2b2140" />
        <path d="M29.5 18 L31.5 18 L30.5 19.5 Z" fill="#2b2140" />
      </symbol>
      <symbol id="bicho-garca" viewBox="0 0 40 40">
        <path d="M17 29 L15 38 M21 29 L22 38" stroke="#2b2140" stroke-width="2.2" stroke-linecap="round" />
        <path d="M24 10 C20 14 22 18 22 22" fill="none" stroke="#2b2140" stroke-width="6" stroke-linecap="round" />
        <path d="M24 10 C20 14 22 18 22 22" fill="none" stroke="#fff" stroke-width="2.8" stroke-linecap="round" />
        <path d="M6 22 Q14 17 26 21 Q30 26 22 30 Q12 32 6 22 Z" fill="#fff" stroke="#2b2140" stroke-width="2.6" stroke-linejoin="round" />
        <circle cx="26" cy="8" r="4.5" fill="#fff" stroke="#2b2140" stroke-width="2.4" />
        <path d="M30 7 L39 9 L30 10 Z" fill="#ffc933" stroke="#2b2140" stroke-width="1.8" stroke-linejoin="round" />
        <circle cx="27" cy="7.5" r="1.2" fill="#2b2140" />
      </symbol>
      <symbol id="bicho-jacare" viewBox="0 0 40 40">
        <path d="M2 24 Q8 20 14 21 L20 18 Q28 17 38 21 Q38 25 30 25 L14 28 Q6 29 2 24 Z" fill="#5b8f3a" stroke="#2b2140" stroke-width="2.6" stroke-linejoin="round" />
        <path d="M9 21 L11 18 L13 21 M15 20 L17 17 L19 19.5" fill="#5b8f3a" stroke="#2b2140" stroke-width="2" stroke-linejoin="round" />
        <circle cx="24" cy="17" r="3" fill="#5b8f3a" stroke="#2b2140" stroke-width="2" />
        <circle cx="24.5" cy="16.5" r="1.2" fill="#2b2140" />
        <path d="M28 23 L36 22.5" stroke="#2b2140" stroke-width="1.6" stroke-linecap="round" />
        <rect x="12" y="27" width="4" height="5" rx="1.5" fill="#5b8f3a" stroke="#2b2140" stroke-width="2" />
        <rect x="24" y="25" width="4" height="5" rx="1.5" fill="#5b8f3a" stroke="#2b2140" stroke-width="2" />
      </symbol>
    </defs>
  </svg>

  <ol id="meses" class="meses" aria-label="Meses do ano"></ol>

  <div id="pantanal" class="pantanal" data-estacao="cheia">
    <div class="ceu" aria-hidden="true"><span class="astro"></span></div>
    <div class="arvore" aria-hidden="true"></div>
    <div class="lagoa" aria-hidden="true"></div>
    <div class="zona zona-onca" data-especie="onca"></div>
    <div class="zona zona-capivara" data-especie="capivara"></div>
    <div class="zona zona-capim" data-especie="capim"></div>
    <div class="zona zona-garca" data-especie="garca"></div>
    <div class="zona zona-jacare" data-especie="jacare"></div>
    <div class="zona zona-peixe" data-especie="peixe"></div>
    <div class="cena-botoes">
      <button id="regras" class="redondo" type="button" aria-label="Quem come quem?">?</button>
      <button id="dica" class="redondo" type="button" aria-label="Dica" hidden>💡</button>
    </div>
    <div id="metas" class="metas" role="img"></div>
  </div>

  <div class="painel-baixo">
    <svg id="grafico" class="grafico" role="img" aria-label="Gráfico dos bichos mês a mês"></svg>
    <p id="fala" class="fala" aria-live="polite"></p>
    <div id="mao" class="mao"></div>
  </div>
</Jogo>

<script>
  import "../../jogos/pantanal/jogo";
</script>
