---
import Jogo from "../../layouts/Jogo.astro";
import "../../jogos/luz/jogo.css";
---

<Jogo id="luz">
  <svg class="moldes" aria-hidden="true">
    <symbol id="casa" viewBox="0 0 100 100">
      <path class="predio-telhado" d="M12 50 L50 16 L88 50 Z"></path>
      <rect class="predio-parede" x="22" y="48" width="56" height="42" rx="4"></rect>
      <rect class="predio-janela" x="31" y="58" width="17" height="17" rx="3"></rect>
      <rect class="predio-janela" x="55" y="58" width="15" height="31" rx="3"></rect>
    </symbol>
    <symbol id="fabrica" viewBox="0 0 100 100">
      <rect class="predio-chamine" x="68" y="12" width="14" height="40" rx="3"></rect>
      <path class="predio-parede" d="M10 90 V44 L34 58 V44 L58 58 V44 L90 58 V90 Z"></path>
      <rect class="predio-janela" x="19" y="66" width="16" height="14" rx="3"></rect>
      <rect class="predio-janela" x="42" y="66" width="16" height="14" rx="3"></rect>
      <rect class="predio-janela" x="65" y="66" width="16" height="14" rx="3"></rect>
    </symbol>
    <symbol id="usina" viewBox="0 0 100 100">
      <rect class="usina-corpo" x="12" y="20" width="76" height="68" rx="10"></rect>
      <path class="usina-raio" d="M56 26 L34 58 H49 L43 82 L67 47 H52 Z"></path>
    </symbol>
    <symbol id="bateria" viewBox="0 0 100 100">
      <rect class="usina-corpo" x="38" y="10" width="24" height="12" rx="3"></rect>
      <rect class="bateria-corpo" x="22" y="20" width="56" height="72" rx="10"></rect>
    </symbol>
  </svg>

  <div class="medidor">
    <span id="contagem" class="contagem">⚡ <strong id="restam" class="numero">0</strong> <span id="palavra">toques</span></span>
    <div id="barra-toques" class="barra"><div id="barra"></div></div>
    <button id="dica" class="botao botao-claro botao-pequeno" type="button" hidden>Dica</button>
  </div>

  <div id="vila" class="vila" data-acesa="">
    <div class="ceu" aria-hidden="true"></div>
    <div id="tabuleiro" class="tabuleiro"></div>
    <p id="fala" class="fala" aria-live="polite"></p>
  </div>
</Jogo>

<script>
  import "../../jogos/luz/jogo";
</script>
