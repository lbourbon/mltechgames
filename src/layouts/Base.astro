---
import Janelas from "../components/Janelas.astro";
import "../styles/site.css";

interface Props {
  titulo?: string;
  descricao?: string;
  // Troca o logo por um botão de voltar, nas páginas de onde a criança precisa achar a saída.
  voltar?: boolean;
  // Cartão que aparece quando o link é compartilhado (scripts/imagens.mjs).
  imagem?: string;
}

const {
  titulo,
  descricao = "Jogos online grátis para crianças. Sem download, é só clicar e jogar.",
  voltar = false,
  imagem = "/img/social/site.jpg",
} = Astro.props;
const tituloInteiro = titulo ? `${titulo} | ML Tech Games` : "ML Tech Games";
const endereco = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={descricao} />
    <meta name="theme-color" content="#fff8e7" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="canonical" href={endereco} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ML Tech Games" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:title" content={tituloInteiro} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={endereco} />
    <meta property="og:image" content={new URL(imagem, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{tituloInteiro}</title>
  </head>
  <body>
    <header class="topo">
      {
        voltar ? (
          <a class="botao botao-pequeno voltar" href="/">
            <span aria-hidden="true">←</span> Voltar
          </a>
        ) : (
          <a class="marca" href="/" aria-label="ML Tech Games">
            <img src="/favicon.svg" alt="" width="34" height="31" />
            <span>ML Tech Games</span>
          </a>
        )
      }
      <nav class="topo-acoes">
        <button id="botao-conta" class="botao botao-pequeno" type="button">Entrar</button>
        <button class="botao botao-pequeno botao-doar" type="button" data-abrir="janela-doacao">Doar</button>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="rodape">
      <p>Grátis e sem anúncios.</p>
      <a class="link" href="/responsaveis/">Para responsáveis</a>
      ·
      <button class="link" type="button" data-abrir="janela-doacao">Apoiar com uma doação</button>
    </footer>
    <Janelas />
    <script>
      import "../lib/interface";
    </script>
  </body>
</html>
