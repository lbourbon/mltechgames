{
  "name": "mltechgames",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev",
    "check": "astro check",
    "test": "vitest run",
    "test:regras": "firebase emulators:exec --only firestore --project demo-mltg \"vitest run --config vitest.regras.config.ts\"",
    "test:e2e": "firebase emulators:exec --only auth,firestore --project demo-mltg \"playwright test\"",
    "deploy": "npm run build && wrangler deploy",
    "deploy:regras": "firebase deploy --only firestore:rules"
  },
  "dependencies": {
    "firebase": "^13.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.64.1",
    "astro": "^7.4.4",
    "firebase-tools": "^15.34.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  }
}
