---
import Base from "./Base.astro";
import { JOGOS, type JogoId } from "../lib/jogos";
import "../styles/jogo.css";

interface Props {
  id: JogoId;
}

const { id } = Astro.props;
const { nome, descricao, comoJogar, cor } = JOGOS.find((jogo) => jogo.id === id)!;
---

<Base titulo={nome} descricao={descricao} voltar>
  <div class="jogo">
    <div class="placa">
      <span id="vidas" role="img"></span>
      <span>Fase <strong id="fase">1</strong></span>
      <span><strong id="pontos" class="numero">0</strong> pontos</span>
      <button id="som" class="som" type="button" aria-label="Som" aria-pressed="true">🔊</button>
    </div>

    <!-- O painel cobre só o palco: a placa e o botão de som continuam à vista. -->
    <div class="palco">
      <div class="cenario"><slot /></div>

      <div id="painel" class="painel" data-jogo={id}>
        <div class="cartaz">
          <img class="capa" src={`/img/jogos/${id}.svg`} alt="" width="640" height="400" style={`--cor: ${cor}`} />
          <h1>{nome}</h1>
          <p>{comoJogar}</p>
        </div>
      </div>
    </div>

    <!-- Celular deitado: nenhum jogo cabe na altura que sobra (styles/jogo.css). -->
    <div class="vire" aria-hidden="true">
      <span class="vire-aparelho">📱</span>
      <p>Vire o aparelho em pé para jogar!</p>
    </div>
  </div>
</Base>
